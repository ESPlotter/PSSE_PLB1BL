@! ======================================================================
@! Test bench dynamic data
@!   bus 3 (50 kV)  : slack source replaying voltage and frequency
@!   bus 1 (0.8 kV) : load driven by the demand table sample.lpb
@! ======================================================================
@!
@! ----------------------------------------------------------------------
@! Slack source PLBVFU1: replays the voltage and frequency stored in the
@! .plb file named by ICON 3 (Flat.plb holds 1.0 pu and 60 Hz).
@!   bus 'USRMDL' id 'name' IC=1 IT=1 NI=3 NC=4 NS=3 NV=6
@! ----------------------------------------------------------------------
3 'USRMDL' '1' 'PLBVFU1' 1 1 3 4 3 6
@! --------------------- ICONS -------------------------------------------
@!   1.V_playback   2.F_playback   3.'plb_file_without_extension'
     1              1              'Flat'
@! --------------------- CONS --------------------------------------------
@!   1.Vscale   2.fscale   3.Tv [s]   4.Tf [s]
     1.00       60.00      0.00       0.00  /
@!
@! ----------------------------------------------------------------------
@! Table-driven load LPB1BL: P and Q read from the .lpb file named by
@! ICON 3, each through an optional first-order lag.
@!   bus 'USRLOD' id 'name' IC=12 IT=1 NI=3 NC=2 NS=0 NV=8 NREF=0
@! ----------------------------------------------------------------------
1 'USRLOD' '1' 'LPB1BL' 12 1 3 2 0 8 0
@! --------------------- ICONS -------------------------------------------
@!   1.P_enable   2.Q_enable   3.'lpb_file_without_extension'
     1            1            'sample'
@! --------------------- CONS (a lag below 4*DELT is bypassed) ----------
@!   1.Tfp [s]   2.Tfq [s]
     0.0         0.0  /
